# ============================================================
# HackDekh Backend Environment Variables (AWS Branch)
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
# `.env` is gitignored — never commit real credentials.
# ============================================================

# --- Server Configuration ---
PORT=8000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
APP_NAME=HackDekh

# --- AWS Cloud & DynamoDB (Member 1) ---
# Region in which your AWS resources live (e.g. us-east-1 for AWS Academy, ap-south-1 for Mumbai)
AWS_REGION=us-east-1

# AWS CLI / IAM credentials:
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# Session Token: MANDATORY for AWS Academy Learner Lab; omit if using personal AWS account
# AWS_SESSION_TOKEN=your_aws_session_token_here

# Base name prepended to all DynamoDB tables (defaults to "hackdekh")
DYNAMODB_TABLE_PREFIX=hackdekh

# DynamoDB Local endpoint (ONLY for offline Docker local development).
# Omit or comment out when running against real AWS cloud!
# DYNAMODB_ENDPOINT=http://localhost:8000

# --- Amazon S3 File Storage (Member 2) ---
# Name of your S3 bucket for avatars, project files, and attachments
AWS_S3_BUCKET_NAME=your_s3_bucket_name_here

# --- Authentication / JWT ---
ACCESS_TOKEN_SECRET=your_jwt_access_token_secret_32_chars_min
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=your_jwt_refresh_token_secret_32_chars_min
REFRESH_TOKEN_EXPIRY=10d

# --- GitHub OAuth ---
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# --- Scraper cron ---
# Shared secret required to trigger scraper cron endpoints (x-cron-secret header)
CRON_SECRET=your_cron_authorization_secret

# --- SMTP / Email delivery (Team invitation emails) ---
# Standard SMTP fallback (e.g. Brevo / Gmail)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM=HackDekh <noreply@hackdekh.com>
