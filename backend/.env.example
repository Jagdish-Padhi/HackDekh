# ============================================================
# HackDekh Backend Environment Variables
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
# `.env` is gitignored — never commit real credentials.
# ============================================================

# --- Server ---
PORT=8001
# Note: 8001 avoids clashing with DynamoDB Local, which uses host port 8000.
# Public URL of the frontend (used when building invitation links)
FRONTEND_URL=http://localhost:5173
# Optional product name used in emails (defaults to "HackDekh")
APP_NAME=HackDekh

# --- Database / DynamoDB & Storage / AWS S3 ---
# Region in which DynamoDB tables and S3 bucket live (e.g., ap-south-1 or us-east-1 for AWS Academy)
AWS_REGION=ap-south-1
# Credentials: IAM user / role keys or AWS Academy temporary credentials.
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
# Optional: Required for AWS Academy Learner Lab temporary session tokens
AWS_SESSION_TOKEN=
# S3 Bucket name for hackathon stage attachments, pitch decks, and deliverables
AWS_S3_BUCKET_NAME=hackdekh-stage-deliverables
# Optional: base name prepended to all table names (defaults to "hackdekh")
DYNAMODB_TABLE_PREFIX=hackdekh
# Optional: DynamoDB Local endpoint (only for local development).
# The docker-compose file exposes it on http://localhost:8000.
# Omit this variable when running against real AWS.
DYNAMODB_ENDPOINT=http://localhost:8000


# --- Authentication / JWT ---
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRY=7d

# --- GitHub OAuth ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- SMTP / Email delivery (team invitation emails) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Scraper cron ---
# Shared secret required to trigger the scraper cron endpoint (x-cron-secret header)
CRON_SECRET=