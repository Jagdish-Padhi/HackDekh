# ============================================================
# HackDekh Backend Environment Variables
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
# `.env` is gitignored — never commit real credentials.
# ============================================================

# --- Server ---
PORT=8000
# Public URL of the frontend (used when building invitation links)
FRONTEND_URL=http://localhost:5173
# Optional product name used in emails (defaults to "HackDekh")
APP_NAME=HackDekh

# --- Database / DynamoDB ---
# Region in which the DynamoDB tables live
AWS_REGION=ap-south-1
# Credentials: prefer an IAM role in production. Locally these dummy values
# satisfy DynamoDB Local; never hardcode real keys.
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
# Optional: base name prepended to all table names (defaults to "hackdekh")
DYNAMODB_TABLE_PREFIX=hackdekh
# Optional: DynamoDB Local endpoint (only for local development).
# The docker-compose file exposes it on http://localhost:8000.
# Omit this variable when running against real AWS.
DYNAMODB_ENDPOINT=http://localhost:8000

# --- Authentication / JWT ---
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRY=7d

# --- GitHub OAuth ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- SMTP / Email delivery (team invitation emails) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Scraper cron ---
# Shared secret required to trigger the scraper cron endpoint (x-cron-secret header)
CRON_SECRET=