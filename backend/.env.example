# ============================================================
# HackDekh Backend Environment Variables
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
# `.env` is gitignored — never commit real credentials.
# ============================================================

# --- Server ---
PORT=8000
# Public URL of the frontend (used when building invitation links)
FRONTEND_URL=http://localhost:5173
# Optional product name used in emails (defaults to "HackDekh")
APP_NAME=HackDekh

# --- MongoDB ---
# Connection string WITHOUT the database name; the DB name comes from DB_NAME.
MONGO_URI=

# --- Authentication / JWT ---
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRY=7d

# --- GitHub OAuth ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- SMTP / Email delivery (team invitation emails) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Scraper cron ---
# Shared secret required to trigger the scraper cron endpoint (x-cron-secret header)
CRON_SECRET=

# --- AWS / DynamoDB (notifications feed) ---
# Region in which the DynamoDB table lives
AWS_REGION=ap-south-1
# Credentials: prefer an IAM role in production. Locally these dummy values
# satisfy DynamoDB Local; never hardcode real keys.
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
# Notifications feed table name
DYNAMODB_TABLE_NOTIFICATIONS=hackdekh-notifications
# Number of days a notification is retained before DynamoDB TTL deletes it
DYNAMODB_TTL_DAYS=90
# Optional: DynamoDB Local endpoint (only for local development).
# If using Docker, expose it on a non-conflicting port, e.g. http://localhost:8001
DYNAMODB_ENDPOINT=http://localhost:8001