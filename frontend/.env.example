# ============================================================
# HackDekh Frontend Environment Variables
# Vite only exposes variables prefixed with VITE_ to the bundle.
# Copy this file to `.env` (or `.env.local`):
#   cp .env.example .env
# These files are gitignored — never commit real secrets.
# ============================================================

# Base URL of the HackDekh API (see backend/.env.example -> PORT)
# Note: backend routes are mounted under /api/v1
VITE_BACKEND_URL=http://localhost:8000/api/v1

# GitHub OAuth client ID used for sign-in
VITE_GITHUB_CLIENT_ID=your_github_client_id
